<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="mail.DiscussContent" t-inherit-mode="extension">

        <xpath expr="//Composer" position="before">
            <div t-if="this.dsolutionIsWhatsappChat and !this.dsolutionWhatsappWindowClosed"
                 class="o-dsolution-whatsapp-window d-flex align-items-center justify-content-between gap-2 mx-2 mb-1 px-3 py-2 rounded">

                <span class="small">
                    <i class="fa fa-whatsapp me-1"/>
                    <t t-out="this.dsolutionWhatsappWindowLabel"/>
                </span>

                <button type="button"
                        class="btn btn-sm btn-outline-primary"
                        t-on-click="this.dsolutionOpenWhatsappTemplateWizard">
                    Enviar plantilla
                </button>
            </div>
        </xpath>

        <xpath expr="//span[@t-if='this.thread.channel?.composerHidden and this.thread.channel?.composerHiddenText']"
               position="replace">

            <div t-if="this.thread.channel?.composerHidden and this.thread.channel?.composerHiddenText"
                 class="bg-200 py-2 px-3 d-flex align-items-center justify-content-between gap-2 text-muted">

                <span class="fst-italic fw-bold"
                      t-out="this.thread.channel?.composerHiddenText"/>

                <button t-if="this.dsolutionWhatsappWindowClosed"
                        type="button"
                        class="btn btn-sm btn-outline-primary"
                        t-on-click="this.dsolutionOpenWhatsappTemplateWizard">
                    Enviar plantilla
                </button>
            </div>

        </xpath>

    </t>

</templates>
