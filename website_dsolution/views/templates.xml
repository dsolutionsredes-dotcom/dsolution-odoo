<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <template id="header" name="D-Solution Header">
        <div class="ds-intro-loader is-visible" aria-hidden="true">
            <div class="ds-intro-loader-inner">
                <img src="/website_dsolution/static/src/img/content/ds-logo-mark-dark.png" alt="D-Solution" class="ds-intro-loader-logo"/>
                <div class="ds-intro-loader-line"><span/></div>
                <p>Audiovisual · Marketing Digital · Desarrollo Web</p>
            </div>
        </div>
        <header class="ds-header">
            <nav class="ds-nav" aria-label="Navegación principal">
                <a class="ds-brand" href="/" aria-label="D-Solution Inicio">
                    <img class="ds-brand-logo ds-brand-logo--light" src="/website_dsolution/static/src/img/content/ds-logo-mark-light.png" alt="D-Solution"/>
                    <img class="ds-brand-logo ds-brand-logo--dark" src="/website_dsolution/static/src/img/content/ds-logo-mark-dark.png" alt="D-Solution"/>
                    <span class="ds-brand-copy">
                        <span class="ds-brand-name">D-Solution</span>
                        <span class="ds-brand-tagline">Audiovisual · Marketing Digital · Desarrollo Web</span>
                    </span>
                </a>

                <div class="ds-nav-links">
                    <a href="/#inicio">Inicio</a>
                    <div class="ds-services-wrap">
                        <a href="/servicios">Servicios</a>
                        <button class="ds-services-toggle js_ds_services_toggle" type="button" aria-label="Abrir servicios" aria-expanded="false">
                            <svg class="ds-services-chevron" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                                <path d="M3.5 6 8 10.5 12.5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </button>
                        <div class="ds-services-menu">
                            <a href="/servicios/tecnologia-audiovisual">Audiovisual</a>
                            <a href="/servicios/marketing-digital">Marketing Digital</a>
                            <a href="/servicios/desarrollo-web">Desarrollo Web</a>
                            <a href="/servicios/automatizacion-ia">IA y Automatización</a>
                            <a href="/servicios/branding-diseno">Branding y Diseño</a>
                            <a href="/servicios/fotografia-profesional">Fotografía Profesional</a>
                        </div>
                    </div>
                    <a href="/#portafolio">Portafolio</a>
                    <a href="/#proceso">Proceso</a>
                    <a href="/#contacto">Contacto</a>
                </div>

                <div class="ds-nav-actions">
                    <div class="ds-language-wrap" aria-label="Idiomas">
                        <t t-if="len(frontend_languages) &gt; 1">
                            <t t-set="ds_active_lang" t-value="frontend_languages.get(lang)"/>
                            <div class="ds-language-native js_language_selector">
                                <a t-foreach="frontend_languages.values()" t-as="lg" t-att-href="url_localized(lang_code=lg.code, prefetch_langs=True, force_default_lang=True)" t-attf-class="js_change_lang #{'is-active' if ds_active_lang == lg else ''}" t-att-data-url_code="lg.url_code" t-att-title="lg.name">
                                    <t t-out="lg.url_code.upper()"/>
                                </a>
                            </div>
                        </t>
                    </div>
                    <a class="ds-cta" href="/#contacto">Hablemos de tu proyecto</a>
                </div>

                <button class="ds-mobile-toggle js_ds_mobile_toggle" type="button" aria-label="Abrir menú" aria-expanded="false">☰</button>
            </nav>

            <div class="ds-mobile-menu">
                <a href="/#inicio">Inicio</a>
                <a href="/servicios">Servicios</a>
                <div class="ds-mobile-submenu">
                    <a href="/servicios/tecnologia-audiovisual">Audiovisual</a>
                    <a href="/servicios/marketing-digital">Marketing Digital</a>
                    <a href="/servicios/desarrollo-web">Desarrollo Web</a>
                    <a href="/servicios/automatizacion-ia">IA y Automatización</a>
                    <a href="/servicios/branding-diseno">Branding y Diseño</a>
                    <a href="/servicios/fotografia-profesional">Fotografía Profesional</a>
                </div>
                <a href="/#portafolio">Portafolio</a>
                <a href="/#proceso">Proceso</a>
                <a href="/#contacto">Contacto</a>
                <div class="ds-mobile-language-wrap" aria-label="Idiomas">
                    <t t-if="len(frontend_languages) &gt; 1">
                        <t t-set="ds_active_lang_mobile" t-value="frontend_languages.get(lang)"/>
                        <div class="ds-language-native ds-language-native--mobile js_language_selector">
                            <a t-foreach="frontend_languages.values()" t-as="lg" t-att-href="url_localized(lang_code=lg.code, prefetch_langs=True, force_default_lang=True)" t-attf-class="js_change_lang #{'is-active' if ds_active_lang_mobile == lg else ''}" t-att-data-url_code="lg.url_code" t-att-title="lg.name">
                                <t t-out="lg.url_code.upper()"/>
                            </a>
                        </div>
                    </t>
                </div>
                <a class="ds-btn ds-btn--gold" href="/#contacto">Hablemos de tu proyecto <span aria-hidden="true">→</span></a>
            </div>
        </header>
    </template>

    <template id="services_grid" name="D-Solution Services Grid">
        <div class="ds-services-grid ds-reveal">
            <a class="ds-service-card" href="/servicios/tecnologia-audiovisual">
                <img src="/website_dsolution/static/src/img/content/service-audiovisual.jpg" alt="Audiovisual" class="img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                <div class="ds-service-content"><span class="ds-service-number">01</span><h3>Audiovisual</h3><span class="ds-service-link">Explorar servicio →</span></div>
            </a>
            <a class="ds-service-card" href="/servicios/marketing-digital">
                <img src="/website_dsolution/static/src/img/content/service-marketing.jpg" alt="Marketing Digital" class="img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                <div class="ds-service-content"><span class="ds-service-number">02</span><h3>Marketing Digital</h3><span class="ds-service-link">Explorar servicio →</span></div>
            </a>
            <a class="ds-service-card" href="/servicios/desarrollo-web">
                <img src="/website_dsolution/static/src/img/content/service-web.jpg" alt="Desarrollo Web" class="img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                <div class="ds-service-content"><span class="ds-service-number">03</span><h3>Desarrollo Web</h3><span class="ds-service-link">Explorar servicio →</span></div>
            </a>
            <a class="ds-service-card" href="/servicios/automatizacion-ia">
                <img src="/website_dsolution/static/src/img/content/service-automation.jpg" alt="IA y Automatización" class="img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                <div class="ds-service-content"><span class="ds-service-number">04</span><h3>IA y Automatización</h3><span class="ds-service-link">Explorar servicio →</span></div>
            </a>
            <a class="ds-service-card" href="/servicios/branding-diseno">
                <img src="/website_dsolution/static/src/img/content/service-branding.jpg" alt="Branding y Diseño" class="img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                <div class="ds-service-content"><span class="ds-service-number">05</span><h3>Branding y Diseño</h3><span class="ds-service-link">Explorar servicio →</span></div>
            </a>
            <a class="ds-service-card" href="/servicios/fotografia-profesional">
                <img src="/website_dsolution/static/src/img/content/service-photography.jpg" alt="Fotografía Profesional" class="img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                <div class="ds-service-content"><span class="ds-service-number">06</span><h3>Fotografía Profesional</h3><span class="ds-service-link">Explorar servicio →</span></div>
            </a>
        </div>
    </template>

    <template id="contact" name="D-Solution Contact CRM Form">
        <t t-set="ds_is_en" t-value="lang == 'en_US' or lang == 'en'"/>
        <t t-set="ds_contact_eyebrow" t-value="'Contact' if ds_is_en else 'Contacto'"/>
        <t t-set="ds_contact_title" t-value="&quot;Let's talk about your next project&quot; if ds_is_en else 'Hablemos de tu próximo proyecto'"/>
        <t t-set="ds_name_label" t-value="'Full name *' if ds_is_en else 'Nombre completo *'"/>
        <t t-set="ds_phone_label" t-value="'Phone / WhatsApp' if ds_is_en else 'Teléfono / WhatsApp'"/>
        <t t-set="ds_company_label" t-value="'Company / Project' if ds_is_en else 'Empresa / Proyecto'"/>
        <t t-set="ds_message_label" t-value="'Tell us about your project *' if ds_is_en else 'Cuéntanos sobre tu proyecto *'"/>
        <t t-set="ds_send_label" t-value="'Send message' if ds_is_en else 'Enviar mensaje'"/>
        <section id="contacto" class="ds-contact-wrap" data-name="D-Solution Contacto">
            <div class="ds-contact ds-reveal">
                <div>
                    <p class="ds-eyebrow"><t t-out="ds_contact_eyebrow"/></p>
                    <h2 class="ds-title"><t t-out="ds_contact_title"/></h2>
                    <span class="ds-divider"/>
                    <div class="ds-contact-info">
                        <a href="mailto:dsolutions.redes@gmail.com">✉ dsolutions.redes@gmail.com</a>
                        <a href="https://wa.me/34624571859" target="_blank" rel="noopener">◉ +34 624 57 18 59</a>
                        <a href="https://www.google.com/maps/search/?api=1&amp;query=Barcelona%2C%20Espa%C3%B1a" target="_blank" rel="noopener">⌖ <t t-out="'Barcelona, Spain' if ds_is_en else 'Barcelona, España'"/></a>
                    </div>
                </div>
                <section class="s_website_form ds-contact-form" data-vcss="001" data-snippet="s_website_form">
                    <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/gracias" data-pre-fill="true">
                        <input type="hidden" name="name" value="Solicitud desde d-solution.org"/>
                        <div class="s_website_form_rows row s_col_no_bgcolor">
                            <div class="ds-field col-lg-6 s_website_form_field s_website_form_required" data-type="char" data-name="Nombre"><label for="ds_contact_name"><t t-out="ds_name_label"/></label><input id="ds_contact_name" class="form-control s_website_form_input" type="text" name="contact_name" required="1"/></div>
                            <div class="ds-field col-lg-6 s_website_form_field s_website_form_required" data-type="email" data-name="Email"><label for="ds_email">Email *</label><input id="ds_email" class="form-control s_website_form_input" type="email" name="email_from" required="1"/></div>
                            <div class="ds-field col-lg-6 s_website_form_field" data-type="tel" data-name="Teléfono"><label for="ds_phone"><t t-out="ds_phone_label"/></label><input id="ds_phone" class="form-control s_website_form_input" type="tel" name="phone"/></div>
                            <div class="ds-field col-lg-6 s_website_form_field" data-type="char" data-name="Empresa"><label for="ds_company"><t t-out="ds_company_label"/></label><input id="ds_company" class="form-control s_website_form_input" type="text" name="partner_name"/></div>
                            <div class="ds-field col-12 s_website_form_field s_website_form_required" data-type="text" data-name="Mensaje"><label for="ds_description"><t t-out="ds_message_label"/></label><textarea id="ds_description" class="form-control s_website_form_input" name="description" required="1"/></div>
                            <div class="ds-submit col-12 s_website_form_submit"><a href="#" role="button" class="btn s_website_form_send"><t t-out="ds_send_label"/></a><span id="s_website_form_result"/></div>
                        </div>
                    </form>
                </section>
            </div>
        </section>
    </template>

    <template id="footer" name="D-Solution Footer">
        <t t-set="ds_is_en" t-value="lang == 'en_US' or lang == 'en'"/>
        <footer class="ds-footer">
            <div class="ds-container">
                <div class="ds-footer-grid">
                    <div><a class="ds-footer-brand" href="/"><img src="/website_dsolution/static/src/img/content/ds-logo-mark-light.png" alt="D-Solution" loading="lazy" decoding="async"/><strong>D-Solution</strong></a><p><t t-out="'Audiovisual technology, digital marketing, web development, automation and creativity for businesses that want to grow with clear, professional execution.' if ds_is_en else 'Tecnología audiovisual, marketing digital, desarrollo web, automatización y creatividad para negocios que quieren crecer con una ejecución clara y profesional.'"/></p></div>
                    <div><h4><t t-out="'Navigation' if ds_is_en else 'Navegación'"/></h4><div class="ds-footer-links"><a href="/"><t t-out="'Home' if ds_is_en else 'Inicio'"/></a><a href="/servicios"><t t-out="'Services' if ds_is_en else 'Servicios'"/></a><a href="/#portafolio"><t t-out="'Portfolio' if ds_is_en else 'Portafolio'"/></a><a href="/#proceso"><t t-out="'Process' if ds_is_en else 'Proceso'"/></a><a href="/#contacto"><t t-out="'Contact' if ds_is_en else 'Contacto'"/></a></div></div>
                    <div><h4><t t-out="'Services' if ds_is_en else 'Servicios'"/></h4><div class="ds-footer-links"><a href="/servicios/tecnologia-audiovisual">Audiovisual</a><a href="/servicios/marketing-digital"><t t-out="'Digital Marketing' if ds_is_en else 'Marketing Digital'"/></a><a href="/servicios/desarrollo-web"><t t-out="'Web Development' if ds_is_en else 'Desarrollo Web'"/></a><a href="/servicios/automatizacion-ia"><t t-out="'AI &amp; Automation' if ds_is_en else 'IA y Automatización'"/></a><a href="/servicios/branding-diseno"><t t-out="'Branding &amp; Design' if ds_is_en else 'Branding y Diseño'"/></a><a href="/servicios/fotografia-profesional"><t t-out="'Professional Photography' if ds_is_en else 'Fotografía Profesional'"/></a></div></div>
                </div>
                <div class="ds-footer-bottom"><t t-out="'© 2026 D-Solution. All rights reserved.' if ds_is_en else '© 2026 D-Solution. Todos los derechos reservados.'"/></div>
            </div>
        </footer>
        <a class="ds-whatsapp-float" href="https://wa.me/34624571859?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20sus%20servicios." target="_blank" rel="noopener" t-att-aria-label="'Open WhatsApp' if ds_is_en else 'Abrir WhatsApp'"><img src="/website_dsolution/static/src/img/content/whatsapp-icon.png" alt="WhatsApp" class="ds-whatsapp-icon" decoding="async"/></a>
    </template>

    <template id="service_page_shell" name="D-Solution Service Page Shell">
        <t t-set="no_header" t-value="True"/>
        <t t-set="no_footer" t-value="True"/>
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure dsolution-page dsolution-service-page">
                <t t-call="website_dsolution.header"/>
                <section class="ds-service-hero">
                    <img t-att-src="service_image" t-att-alt="service_title" loading="lazy" decoding="async"/>
                    <div class="ds-service-hero-inner ds-reveal">
                        <span class="ds-service-hero-number"><t t-out="service_number"/></span>
                        <h1><t t-out="service_title"/></h1>
                        <p><t t-out="service_intro"/></p>
                        <div class="ds-hero-actions" style="justify-content:flex-start">
                            <a class="ds-btn ds-btn--gold" href="#contacto">Hablemos de tu proyecto</a>
                            <a class="ds-btn ds-btn--outline" href="/servicios">Todos los servicios</a>
                        </div>
                    </div>
                </section>
                <section class="ds-section">
                    <div class="ds-container ds-service-content-grid">
                        <div class="ds-reveal">
                            <p class="ds-eyebrow">Qué hacemos</p>
                            <h2 class="ds-title"><t t-out="service_heading"/></h2>
                            <span class="ds-divider"/>
                            <p class="ds-subtitle"><t t-out="service_body"/></p>
                        </div>
                        <div class="ds-service-points ds-reveal">
                            <t t-foreach="service_points" t-as="point">
                                <div class="ds-service-point"><strong><t t-out="point[0]"/></strong><span><t t-out="point[1]"/></span></div>
                            </t>
                        </div>
                    </div>
                </section>
                <t t-call="website_dsolution.contact"/>
                <t t-call="website_dsolution.footer"/>
            </div>
        </t>
    </template>

</odoo>
