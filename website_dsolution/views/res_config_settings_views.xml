<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dsolution" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dsolution</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="after">
                <block title="D-Solution" id="dsolution_website_settings">
                    <setting id="dsolution_hero_video_url_setting"
                             string="Hero video URL"
                             help="URL pública directa al MP4 del Hero. Recomendado: CDN u object storage; evita servir vídeos pesados mediante /web/content.">
                        <div class="content-group">
                            <field name="dsolution_hero_video_url"
                                   placeholder="https://cdn.ejemplo.com/hero-dsolution.mp4"
                                   class="w-100"/>
                            <div class="text-muted mt-2">
                                Recomendado: MP4 H.264, 1920x1080, 24-30 fps, sin audio, faststart y una URL pública directa HTTPS.
                            </div>
                            <div class="text-muted mt-1">
                                Desde v0.18 el MP4 subido anteriormente a Odoo no se usa en la web pública para evitar descargas lentas desde /web/content.
                            </div>
                        </div>
                    </setting>
                    <setting id="dsolution_hero_image_setting"
                             string="Hero image / poster"
                             help="Imagen de respaldo mientras carga el vídeo o si el navegador no puede reproducirlo.">
                        <field name="dsolution_hero_image"
                               widget="image"
                               class="w-50 mt-2"
                               options="{'accepted_file_extensions': '.png,.jpg,.jpeg,.webp'}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
