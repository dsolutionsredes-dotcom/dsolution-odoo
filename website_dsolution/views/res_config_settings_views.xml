<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dsolution" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dsolution</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="after">
                <block title="D-Solution" id="dsolution_website_settings">
                    <setting id="dsolution_hero_video_upload_setting"
                             string="Hero video · subir MP4"
                             help="Sube un MP4 directamente a Odoo. Se almacena como adjunto y se carga de forma diferida para no bloquear la carga inicial de la página.">
                        <div class="content-group">
                            <field name="dsolution_hero_video_filename" invisible="1"/>
                            <field name="dsolution_hero_video"
                                   filename="dsolution_hero_video_filename"
                                   widget="binary"
                                   options="{'accepted_file_extensions': '.mp4'}"/>
                            <div class="text-muted mt-2">
                                Recomendado: H.264, sin audio, faststart y preferiblemente 4-8 MB. La página muestra primero el poster y solicita el vídeo después de cargar el contenido principal.
                            </div>
                        </div>
                    </setting>
                    <setting id="dsolution_hero_video_url_setting"
                             string="Hero video URL"
                             help="URL pública directa al MP4 del Hero. Si completas este campo, tiene prioridad sobre el MP4 subido y es la opción recomendada para máxima velocidad.">
                        <div class="content-group">
                            <field name="dsolution_hero_video_url"
                                   placeholder="https://cdn.ejemplo.com/hero-dsolution.mp4"
                                   class="w-100"/>
                            <div class="text-muted mt-2">
                                Recomendado: MP4 H.264, 1920x1080, 24-30 fps, sin audio, faststart y una URL pública directa HTTPS.
                            </div>
                            <div class="text-muted mt-1">
                                Opcional. Déjalo vacío si prefieres usar el MP4 subido directamente arriba.
                            </div>
                        </div>
                    </setting>
                    <setting id="dsolution_hero_image_setting"
                             string="Hero image / poster"
                             help="Imagen de respaldo mientras carga el vídeo o si el navegador no puede reproducirlo.">
                        <field name="dsolution_hero_image"
                               widget="image"
                               class="w-50 mt-2"
                               options="{'accepted_file_extensions': '.png,.jpg,.jpeg,.webp'}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
