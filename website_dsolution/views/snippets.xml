<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bloques D-Solution disponibles en el Website Builder -->
    <template id="s_ds_hero" name="D-Solution Hero">
        <section t-attf-class="ds-hero ds-hero--builder #{'ds-hero--video' if (website.dsolution_hero_video_url or website.dsolution_hero_video_filename) else ('ds-hero--image' if website.dsolution_hero_image else 'ds-hero--vector-mode')}"
                 data-name="D-Solution Hero"
                 data-snippet="s_ds_hero">
            <t t-if="website.dsolution_hero_video_url or website.dsolution_hero_video_filename">
                <video class="ds-hero-video js_ds_hero_video"
                       autoplay="autoplay"
                       muted="muted"
                       loop="loop"
                       playsinline="playsinline"
                       preload="none"
                       t-att-data-video-url="website.dsolution_hero_video_url or ('/web/content/website/%s/dsolution_hero_video' % website.id)"
                       t-att-poster="'/web/image/website/%s/dsolution_hero_image' % website.id if website.dsolution_hero_image else '/website_dsolution/static/src/img/content/seo-image.jpg'"
                       aria-hidden="true"/>
            </t>
            <img t-elif="website.dsolution_hero_image"
                 class="ds-hero-video"
                 t-att-src="'/web/image/website/%s/dsolution_hero_image' % website.id"
                 alt=""
                 aria-hidden="true"/>
            <t t-else="">
                <div class="ds-hero-grid" aria-hidden="true"/>
                <div class="ds-hero-glow ds-hero-glow--one" aria-hidden="true"/>
                <div class="ds-hero-glow ds-hero-glow--two" aria-hidden="true"/>
            </t>
            <div class="ds-hero-video-overlay" aria-hidden="true"/>
            <div class="ds-hero-content">
                <h1><strong>Transformamos ideas</strong><span>en experiencias digitales</span></h1>
            </div>
        </section>
    </template>

    <template id="s_ds_content" name="D-Solution Contenido">
        <section class="ds-section" data-name="D-Solution Contenido" data-snippet="s_ds_content">
            <div class="ds-container">
                <p class="ds-eyebrow">D-Solution</p>
                <h2 class="ds-title">Título editable desde Odoo</h2>
                <p class="ds-subtitle">Puedes cambiar este texto directamente desde el editor del sitio web.</p>
                <span class="ds-divider"/>
            </div>
        </section>
    </template>

    <template id="s_ds_media" name="D-Solution Imagen">
        <section class="ds-section ds-builder-media" data-name="D-Solution Imagen" data-snippet="s_ds_media">
            <div class="ds-container">
                <div class="ds-builder-media-grid">
                    <div>
                        <p class="ds-eyebrow">Contenido visual</p>
                        <h2 class="ds-title">Imagen editable</h2>
                        <p class="ds-subtitle">Selecciona la imagen en el editor de Odoo para sustituirla por fotografía propia.</p>
                    </div>
                    <figure class="ds-builder-media-frame">
                        <img src="/website_dsolution/static/src/img/content/service-audiovisual.jpg"
                             alt="Contenido D-Solution"
                             class="img img-fluid o_we_custom_image"/>
                    </figure>
                </div>
            </div>
        </section>
    </template>

    <template id="s_ds_cta" name="D-Solution CTA">
        <section class="ds-section ds-section--blue" data-name="D-Solution CTA" data-snippet="s_ds_cta">
            <div class="ds-container ds-builder-cta">
                <div>
                    <p class="ds-eyebrow">¿Empezamos?</p>
                    <h2 class="ds-title">Hablemos de tu próximo proyecto</h2>
                </div>
                <a class="ds-btn ds-btn--gold" href="#contacto">Contactar →</a>
            </div>
        </section>
    </template>


    <!-- v0.10: plantillas completas de los bloques existentes.
         Evita plantillas vacías y permite al editor trabajar con su contenido interno. -->
    <template id="s_ds_services_full" name="D-Solution Servicios">
<section id="servicios" class="ds-section ds-section--compact" data-name="D-Solution Servicios" data-snippet="s_ds_services_full">
                    <div class="ds-container">
                        <div class="ds-reveal">
                            <p class="ds-eyebrow">Servicios</p>
                            <h2 class="ds-title">Soluciones creativas para impulsar tu negocio</h2>
                            <p class="ds-subtitle">Servicios independientes o integrados en una estrategia completa para tu marca.</p>
                            <span class="ds-divider"/>
                        </div>
                        <t t-call="website_dsolution.services_grid"/>
                    </div>
                </section>
    </template>

    <template id="s_ds_process_full" name="D-Solution Proceso">
<section id="proceso" class="ds-section ds-section--blue" data-name="D-Solution Proceso" data-snippet="s_ds_process_full">
                    <div class="ds-container ds-process-layout">
                        <div class="ds-reveal">
                            <p class="ds-eyebrow">Proceso</p>
                            <h2 class="ds-title">Cómo trabajamos contigo</h2>
                            <p class="ds-subtitle">Un proceso ágil y colaborativo para convertir ideas en resultados reales.</p>
                            <span class="ds-divider"/>
                            <a class="ds-btn ds-btn--outline" style="margin-top:26px;border-color:#D4AF37;color:#D4AF37" href="#contacto">Hablemos de tu proyecto →</a>
                        </div>
                        <div class="ds-process-cards">
                            <article class="ds-process-card ds-reveal">
                                <img src="/website_dsolution/static/src/img/content/process-01-entendemos.jpg" alt="Entendemos" class="img img-fluid o_we_custom_image"/>
                                <div class="ds-process-content"><strong>01</strong><h3>Entendemos</h3><p>Escuchamos tu idea, analizamos tu negocio y definimos objetivos claros.</p></div>
                            </article>
                            <article class="ds-process-card ds-reveal">
                                <img src="/website_dsolution/static/src/img/content/process-02-estrategia.jpg" alt="Estrategia" class="img img-fluid o_we_custom_image"/>
                                <div class="ds-process-content"><strong>02</strong><h3>Estrategia</h3><p>Diseñamos un plan digital con canales, contenido y acciones clave.</p></div>
                            </article>
                            <article class="ds-process-card ds-reveal">
                                <img src="/website_dsolution/static/src/img/content/process-03-creamos.jpg" alt="Creamos y ejecutamos" class="img img-fluid o_we_custom_image"/>
                                <div class="ds-process-content"><strong>03</strong><h3>Creamos y ejecutamos</h3><p>Producimos contenido, lanzamos campañas, webs o automatizaciones.</p></div>
                            </article>
                            <article class="ds-process-card ds-reveal">
                                <img src="/website_dsolution/static/src/img/content/process-04-medimos.jpg" alt="Medimos y optimizamos" class="img img-fluid o_we_custom_image"/>
                                <div class="ds-process-content"><strong>04</strong><h3>Medimos y optimizamos</h3><p>Analizamos resultados y ajustamos para mejorar el impacto.</p></div>
                            </article>
                        </div>
                    </div>
                </section>
    </template>

    <template id="s_ds_portfolio_full" name="D-Solution Portafolio">
<section id="portafolio" class="ds-section ds-section--white">
                    <div class="ds-container">
                        <div class="ds-reveal">
                            <p class="ds-eyebrow">Portafolio</p>
                            <h2 class="ds-title">Proyectos que inspiran nuevas ideas</h2>
                            <p class="ds-subtitle">Una selección inicial de trabajos que combinan estrategia, creatividad y tecnología. Esta sección se conectará después con datos de Odoo.</p>
                            <span class="ds-divider"/>
                        </div>
                        <div class="ds-portfolio-grid">
                            <article class="ds-project ds-reveal"><div class="ds-project-media"><img src="/website_dsolution/static/src/img/content/service-audiovisual.jpg" alt="Producción audiovisual" class="img img-fluid o_we_custom_image"/></div><div class="ds-project-body"><p class="ds-project-category">Audiovisual</p><h3>Producción audiovisual</h3><p>Contenido visual y soporte técnico para comunicar con más impacto.</p><a href="#contacto">Ver proyecto →</a></div></article>
                            <article class="ds-project ds-reveal"><div class="ds-project-media"><img src="/website_dsolution/static/src/img/content/service-marketing.jpg" alt="Campaña digital" class="img img-fluid o_we_custom_image"/></div><div class="ds-project-body"><p class="ds-project-category">Marketing</p><h3>Campaña digital</h3><p>Estrategia, medición y optimización para generar oportunidades reales.</p><a href="#contacto">Ver proyecto →</a></div></article>
                            <article class="ds-project ds-reveal"><div class="ds-project-media"><img src="/website_dsolution/static/src/img/content/service-web.jpg" alt="Sitio web corporativo" class="img img-fluid o_we_custom_image"/></div><div class="ds-project-body"><p class="ds-project-category">Web</p><h3>Sitio web corporativo</h3><p>Diseño y estructura para una presencia digital clara, rápida y premium.</p><a href="#contacto">Ver proyecto →</a></div></article>
                        </div>
                    </div>
                </section>
    </template>

    <template id="s_ds_gallery" name="D-Solution Galería">
        <section class="ds-section ds-gallery-section" data-name="D-Solution Galería" data-snippet="s_ds_gallery">
            <div class="ds-container">
                <div class="ds-gallery-heading">
                    <p class="ds-eyebrow">Galería</p>
                    <h2 class="ds-title">Contenido visual de tu proyecto</h2>
                    <p class="ds-subtitle">Haz clic en cada imagen desde el editor de Odoo para sustituirla.</p>
                    <span class="ds-divider"/>
                </div>
                <div class="ds-gallery-grid">
                    <figure class="ds-gallery-item">
                        <img src="/website_dsolution/static/src/img/content/service-audiovisual.jpg"
                             alt="Galería D-Solution 1"
                             class="img img-fluid o_we_custom_image"/>
                    </figure>
                    <figure class="ds-gallery-item">
                        <img src="/website_dsolution/static/src/img/content/service-marketing.jpg"
                             alt="Galería D-Solution 2"
                             class="img img-fluid o_we_custom_image"/>
                    </figure>
                    <figure class="ds-gallery-item">
                        <img src="/website_dsolution/static/src/img/content/service-photography.jpg"
                             alt="Galería D-Solution 3"
                             class="img img-fluid o_we_custom_image"/>
                    </figure>
                </div>
            </div>
        </section>
    </template>

    <template id="snippets" inherit_id="website.snippets" name="D-Solution Snippets">
        <xpath expr="//snippets[@id='snippet_groups']/t[@id='installed_snippets_hook']" position="before">
            <t snippet-group="dsolution"
               t-snippet="website.s_snippet_group"
               string="D-Solution"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg"/>
        </xpath>

        <xpath expr="//snippets[@id='snippet_structure']/*[1]" position="before">
            <t t-snippet="website_dsolution.s_ds_hero"
               string="D-Solution Hero"
               group="dsolution"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_cover.svg">
                <keywords>hero, portada, banner, d-solution</keywords>
            </t>
            <t t-snippet="website_dsolution.s_ds_content"
               string="D-Solution Contenido"
               group="dsolution"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_text_block.svg">
                <keywords>texto, contenido, título, d-solution</keywords>
            </t>
            <t t-snippet="website_dsolution.s_ds_media"
               string="D-Solution Imagen"
               group="dsolution"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_text_image.svg">
                <keywords>imagen, foto, media, d-solution</keywords>
            </t>
            <t t-snippet="website.s_video"
               string="D-Solution Video"
               group="dsolution"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_video.svg">
                <keywords>video, multimedia, youtube, vimeo, d-solution</keywords>
            </t>
            <t t-snippet="website_dsolution.s_ds_gallery"
               string="D-Solution Galería"
               group="dsolution"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_picture.svg">
                <keywords>galería, imagen, fotos, portfolio, d-solution</keywords>
            </t>
            <t t-snippet="website_dsolution.s_ds_cta"
               string="D-Solution CTA"
               group="dsolution"
               t-thumbnail="/website/static/src/img/snippets_thumbs/s_call_to_action.svg">
                <keywords>cta, contacto, llamada, acción, d-solution</keywords>
            </t>
        </xpath>
    </template>

</odoo>
