                    <div class="ds-stat-head">
                        <img src="/web/image/website_dsolution.img_stat_rocket" alt="Experiencia" class="ds-stat-icon img img-fluid o_we_custom_image"/>
                        <strong>+10</strong>
                    </div>
                    <span>años de experiencia</span>
                </div>
                <div class="ds-stat">
                    <div class="ds-stat-head">
                        <img src="/web/image/website_dsolution.img_stat_folder" alt="Proyectos" class="ds-stat-icon img img-fluid o_we_custom_image"/>
                        <strong>+50</strong>
                    </div>
                    <span>proyectos gestionados</span>
                </div>
                <div class="ds-stat">
                    <div class="ds-stat-head">
                        <img src="/web/image/website_dsolution.img_stat_globe" alt="Servicios" class="ds-stat-icon img img-fluid o_we_custom_image"/>
                        <strong>6</strong>
                    </div>
                    <span>tipos de servicios que dominamos</span>
                </div>
