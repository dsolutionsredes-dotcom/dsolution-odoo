<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Keep only the validated stats override on top of the current homepage view. -->
    <template id="homepage_v0191_overrides" name="D-Solution Homepage v0.19.1 Overrides" inherit_id="website_dsolution.homepage_dsolution" priority="90">

        <xpath expr="//div[hasclass('ds-stats-grid')]" position="replace">
            <div class="ds-stats-grid ds-reveal" data-name="D-Solution Estadísticas">
                <div class="ds-stat">
                    <div class="ds-stat-head">
                        <img src="/web/image/website_dsolution.img_stat_rocket" alt="Experiencia" class="ds-stat-icon img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                        <strong>+10</strong>
                    </div>
                    <span>años de experiencia</span>
                </div>
                <div class="ds-stat">
                    <div class="ds-stat-head">
                        <img src="/web/image/website_dsolution.img_stat_folder" alt="Proyectos" class="ds-stat-icon img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                        <strong>+50</strong>
                    </div>
                    <span>proyectos gestionados</span>
                </div>
                <div class="ds-stat">
                    <div class="ds-stat-head">
                        <img src="/web/image/website_dsolution.img_stat_globe" alt="Servicios" class="ds-stat-icon img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                        <strong>6</strong>
                    </div>
                    <span>tipos de servicios que dominamos</span>
                </div>
                <div class="ds-stat">
                    <div class="ds-stat-head">
                        <img src="/web/image/website_dsolution.img_stat_barchart" alt="Plataformas" class="ds-stat-icon img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                        <strong>+10</strong>
                    </div>
                    <span>plataformas utilizadas a nivel avanzado</span>
                </div>
            </div>
        </xpath>

</template>

    <!-- Contact is a reusable template, so patch it independently. -->
    <template id="contact_v0191_overrides" name="D-Solution Contact v0.19.1 Overrides" inherit_id="website_dsolution.contact" priority="90">

        <!-- Native Odoo spacer. In Edit mode select it and change its top/bottom spacing. -->
        <xpath expr="//section[@id='contacto']/div[hasclass('ds-contact')]" position="before">
            <div class="s_hr ds-contact-top-spacer pt32 pb32" data-snippet="s_hr" data-name="Espacio superior contacto">
                <hr class="d-none"/>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('ds-contact-info')]" position="replace">
            <div class="ds-contact-info">
                <a href="mailto:dsolutions.redes@gmail.com">
                    <img src="/web/image/website_dsolution.img_contact_email" alt="Email" class="ds-contact-icon img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                    <span>dsolutions.redes@gmail.com</span>
                </a>
                <a href="https://wa.me/34624571859" target="_blank" rel="noopener">
                    <img src="/web/image/website_dsolution.img_contact_whatsapp" alt="WhatsApp" class="ds-contact-icon img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                    <span>+34 624 57 18 59</span>
                </a>
                <a href="https://www.google.com/maps/search/?api=1&amp;query=Barcelona%2C%20Espa%C3%B1a" target="_blank" rel="noopener">
                    <img src="/web/image/website_dsolution.img_contact_location" alt="Ubicación" class="ds-contact-icon img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                    <span>Barcelona, España</span>
                </a>
            </div>
        </xpath>
    </template>

</odoo>
