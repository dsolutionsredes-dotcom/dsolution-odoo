    <!-- Contact is a reusable template, so patch it independently. -->
    <template id="contact_v0191_overrides"
              name="D-Solution Contact v0.19.1 Overrides"
              inherit_id="website_dsolution.contact"
              priority="90">

        <!-- Native Odoo spacer. In Edit mode select it and change its top/bottom spacing. -->
        <xpath expr="//section[@id='contacto']/div[hasclass('ds-contact')]" position="before">
            <div class="s_hr ds-contact-top-spacer pt32 pb32"
                 data-snippet="s_hr"
                 data-name="Espacio superior contacto">
                <hr class="d-none"/>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('ds-contact-info')]" position="replace">
            <div class="ds-contact-info">
                <a href="mailto:dsolutions.redes@gmail.com">
                    <img src="/web/image/website_dsolution.img_contact_email" alt="Email"
                         class="ds-contact-icon img img-fluid o_we_custom_image"/>
                    <span>dsolutions.redes@gmail.com</span>
                </a>
                <a href="https://wa.me/34624571859" target="_blank" rel="noopener">
                    <img src="/web/image/website_dsolution.img_contact_whatsapp" alt="WhatsApp"
                         class="ds-contact-icon img img-fluid o_we_custom_image"/>
                    <span>+34 624 57 18 59</span>
                </a>
                <a href="https://www.google.com/maps/search/?api=1&amp;query=Barcelona%2C%20Espa%C3%B1a"
                   target="_blank" rel="noopener">
                    <img src="/web/image/website_dsolution.img_contact_location" alt="Ubicación"
                         class="ds-contact-icon img img-fluid o_we_custom_image"/>
                    <span>Barcelona, España</span>
                </a>
            </div>
        </xpath>
    </template>

</odoo>
