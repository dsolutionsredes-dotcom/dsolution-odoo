                    <div class="ds-stat-head">
                        <img src="/web/image/website_dsolution.img_stat_barchart" alt="Plataformas" class="ds-stat-icon img img-fluid o_we_custom_image"/>
                        <strong>+10</strong>
                    </div>
                    <span>plataformas utilizadas a nivel avanzado</span>
                </div>
            </div>
        </xpath>

