<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <template id="homepage_dsolution" name="D-Solution Homepage" inherit_id="website.homepage">
        <xpath expr="//t[@t-call='website.layout']" position="before">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
        </xpath>
<xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure dsolution-page">
                <t t-call="website_dsolution.header"/>

                <section id="inicio" class="ds-hero ds-hero--video js_ds_lazy_hero_video" data-name="D-Solution Hero" data-snippet="s_ds_hero"
                         t-att-data-ds-video-src="website.dsolution_hero_video_url or ('/web/content/website/%s/dsolution_hero_video' % website.id if website.dsolution_hero_video else '/website_dsolution/static/src/video/hero-dsolution-loop.mp4')">
                    <img class="ds-hero-native-poster"
                             t-att-src="'/web/image/website/%s/dsolution_hero_image' % website.id if website.dsolution_hero_image else '/website_dsolution/static/src/img/content/hero-poster.webp?v=20118'"
                             alt="" aria-hidden="true" width="1280" height="720" loading="eager" fetchpriority="high" decoding="async"/>

                    <div class="ds-hero-video-overlay" aria-hidden="true"/>
                    <div class="ds-hero-content">
                        <h1><strong>Transformamos ideas</strong><span>en experiencias digitales</span></h1>
                    </div>
                </section>

                <section id="servicios" class="ds-section ds-section--compact" data-name="D-Solution Servicios" data-snippet="s_ds_services_full">
                    <div class="ds-container">
                        <div class="ds-reveal">
                            <p class="ds-eyebrow">Servicios</p>
                            <h2 class="ds-title">Soluciones creativas para impulsar tu negocio</h2>
                            <p class="ds-subtitle">Servicios independientes o integrados en una estrategia completa para tu marca.</p>
                            <span class="ds-divider"/>
                        </div>
                        <t t-call="website_dsolution.services_grid"/>
                    </div>
                </section>

                <section id="proceso" class="ds-section ds-section--blue" data-name="D-Solution Proceso" data-snippet="s_ds_process_full">
                    <div class="ds-container ds-process-layout">
                        <div class="ds-reveal">
                            <p class="ds-eyebrow">Proceso</p>
                            <h2 class="ds-title">Cómo trabajamos contigo</h2>
                            <p class="ds-subtitle">Un proceso ágil y colaborativo para convertir ideas en resultados reales.</p>
                            <span class="ds-divider"/>
                            <a class="ds-btn ds-btn--outline" style="margin-top:26px;border-color:#D4AF37;color:#D4AF37" href="#contacto">Hablemos de tu proyecto →</a>
                        </div>
                        <div class="ds-process-cards">
                            <article class="ds-process-card ds-reveal">
                                <img src="/website_dsolution/static/src/img/content/manual-process/process-01-entendemos-manual.webp" alt="Entendemos" class="img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                                <div class="ds-process-content"><strong>01</strong><h3>Entendemos</h3><p>Escuchamos tu idea, analizamos tu negocio y definimos objetivos claros.</p></div>
                            </article>
                            <article class="ds-process-card ds-reveal">
                                <img src="/website_dsolution/static/src/img/content/manual-process/process-02-estrategia-manual.webp" alt="Estrategia" class="img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                                <div class="ds-process-content"><strong>02</strong><h3>Estrategia</h3><p>Diseñamos un plan digital con canales, contenido y acciones clave.</p></div>
                            </article>
                            <article class="ds-process-card ds-reveal">
                                <img src="/website_dsolution/static/src/img/content/manual-process/process-03-creamos-manual.webp" alt="Creamos y ejecutamos" class="img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                                <div class="ds-process-content"><strong>03</strong><h3>Creamos y ejecutamos</h3><p>Producimos contenido, lanzamos campañas, webs o automatizaciones.</p></div>
                            </article>
                            <article class="ds-process-card ds-reveal">
                                <img src="/website_dsolution/static/src/img/content/manual-process/process-04-medimos-manual.webp" alt="Medimos y optimizamos" class="img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                                <div class="ds-process-content"><strong>04</strong><h3>Medimos y optimizamos</h3><p>Analizamos resultados y ajustamos para mejorar el impacto.</p></div>
                            </article>
                        </div>
                    </div>
                </section>

                <section class="ds-section ds-section--compact">
                    <div class="ds-container">
                        <div class="ds-reveal">
                            <p class="ds-eyebrow">¿Por qué elegirnos?</p>
                            <h2 class="ds-title">Resultados que hablan por nosotros</h2>
                            <span class="ds-divider"/>
                        </div>
                        <div class="ds-stats-grid ds-reveal">
                            <div class="ds-stat"><strong>+10</strong><span>años de experiencia</span></div>
                            <div class="ds-stat"><strong>+50</strong><span>proyectos gestionados</span></div>
                            <div class="ds-stat"><strong>6</strong><span>tipos de servicios que dominamos</span></div>
                            <div class="ds-stat"><strong>+10</strong><span>plataformas utilizadas a nivel avanzado</span></div>
                        </div>
                    </div>
                </section>
