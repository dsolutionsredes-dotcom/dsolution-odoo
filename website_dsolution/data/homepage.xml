<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <template id="homepage_dsolution" name="D-Solution Homepage" inherit_id="website.homepage">
        <xpath expr="//t[@t-call='website.layout']" position="before">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
        </xpath>
<xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure dsolution-page">
                <t t-call="website_dsolution.header"/>

                <section id="inicio" class="ds-hero ds-hero--video o_background_video" data-name="D-Solution Hero" data-snippet="s_ds_hero"
                         t-att-data-bg-video-src="website.dsolution_hero_video_url or ('/web/content/website/%s/dsolution_hero_video' % website.id if website.dsolution_hero_video else '/website_dsolution/static/src/video/hero-dsolution-loop.mp4')"
                         data-bg-video-is-file="true">
                    <img t-if="website.dsolution_hero_image" class="ds-hero-native-poster"
                         t-att-src="'/web/image/website/%s/dsolution_hero_image' % website.id"
                         alt="" aria-hidden="true" fetchpriority="high" decoding="async"/>

                    <div class="ds-hero-video-overlay" aria-hidden="true"/>
                    <div class="ds-hero-content ds-reveal">
                        <h1><strong>Transformamos ideas</strong><span>en experiencias digitales</span></h1>
                    </div>
                </section>

                <section id="servicios" class="ds-section ds-section--compact" data-name="D-Solution Servicios" data-snippet="s_ds_services_full">
                    <div class="ds-container">
                        <div class="ds-reveal">
                            <p class="ds-eyebrow">Servicios</p>
                            <h2 class="ds-title">Soluciones creativas para impulsar tu negocio</h2>
                            <p class="ds-subtitle">Servicios independientes o integrados en una estrategia completa para tu marca.</p>
                            <span class="ds-divider"/>
                        </div>
                        <t t-call="website_dsolution.services_grid"/>
                    </div>
                </section>

                <section id="proceso" class="ds-section ds-section--blue" data-name="D-Solution Proceso" data-snippet="s_ds_process_full">
                    <div class="ds-container ds-process-layout">
                        <div class="ds-reveal">
                            <p class="ds-eyebrow">Proceso</p>
                            <h2 class="ds-title">Cómo trabajamos contigo</h2>
                            <p class="ds-subtitle">Un proceso ágil y colaborativo para convertir ideas en resultados reales.</p>
                            <span class="ds-divider"/>
                            <a class="ds-btn ds-btn--outline" style="margin-top:26px;border-color:#D4AF37;color:#D4AF37" href="#contacto">Hablemos de tu proyecto →</a>
                        </div>
                        <div class="ds-process-cards">
                            <article class="ds-process-card ds-reveal">
                                <img src="/website_dsolution/static/src/img/content/process-01-entendemos.jpg" alt="Entendemos" class="img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                                <div class="ds-process-content"><strong>01</strong><h3>Entendemos</h3><p>Escuchamos tu idea, analizamos tu negocio y definimos objetivos claros.</p></div>
                            </article>
                            <article class="ds-process-card ds-reveal">
                                <img src="/website_dsolution/static/src/img/content/process-02-estrategia.jpg" alt="Estrategia" class="img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                                <div class="ds-process-content"><strong>02</strong><h3>Estrategia</h3><p>Diseñamos un plan digital con canales, contenido y acciones clave.</p></div>
                            </article>
                            <article class="ds-process-card ds-reveal">
                                <img src="/website_dsolution/static/src/img/content/process-03-creamos.jpg" alt="Creamos y ejecutamos" class="img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                                <div class="ds-process-content"><strong>03</strong><h3>Creamos y ejecutamos</h3><p>Producimos contenido, lanzamos campañas, webs o automatizaciones.</p></div>
                            </article>
                            <article class="ds-process-card ds-reveal">
                                <img src="/website_dsolution/static/src/img/content/process-04-medimos.jpg" alt="Medimos y optimizamos" class="img img-fluid o_we_custom_image" loading="lazy" decoding="async"/>
                                <div class="ds-process-content"><strong>04</strong><h3>Medimos y optimizamos</h3><p>Analizamos resultados y ajustamos para mejorar el impacto.</p></div>
                            </article>
                        </div>
                    </div>
                </section>

                <section class="ds-section ds-section--compact">
                    <div class="ds-container">
                        <div class="ds-reveal">
                            <p class="ds-eyebrow">¿Por qué elegirnos?</p>
                            <h2 class="ds-title">Resultados que hablan por nosotros</h2>
                            <span class="ds-divider"/>
                        </div>
                        <div class="ds-stats-grid ds-reveal">
                            <div class="ds-stat"><strong>+10</strong><span>años de experiencia</span></div>
                            <div class="ds-stat"><strong>+50</strong><span>proyectos gestionados</span></div>
                            <div class="ds-stat"><strong>6</strong><span>tipos de servicios que dominamos</span></div>
                            <div class="ds-stat"><strong>+10</strong><span>plataformas utilizadas a nivel avanzado</span></div>
                        </div>
                    </div>
                </section>
                <section class="ds-section ds-section--navy" data-name="D-Solution Ecosistema">
                    <div class="ds-container ds-reveal">
                        <p class="ds-eyebrow">Ecosistema</p>
                        <h2 class="ds-title">Herramientas que usamos para crear, medir y optimizar proyectos.</h2>
                        <span class="ds-divider"/>
                    </div>
                    <div class="ds-marquee">
                        <div class="ds-marquee-track">
                            <span class="ds-tool"><span class="ds-tool-logo-slot"><img src="/website_dsolution/static/src/img/brands/canva.svg" alt="Logo Canva" class="ds-tool-logo img img-fluid o_we_custom_image js_ds_tool_logo_source" data-tool-key="canva"/></span><span class="ds-tool-label">Canva</span></span><span class="ds-tool"><span class="ds-tool-logo-slot"><img src="/website_dsolution/static/src/img/brands/meta.svg" alt="Logo Meta Ads" class="ds-tool-logo img img-fluid o_we_custom_image js_ds_tool_logo_source" data-tool-key="meta"/></span><span class="ds-tool-label">Meta Ads</span></span><span class="ds-tool"><span class="ds-tool-logo-slot"><img src="/website_dsolution/static/src/img/brands/google-ads.svg" alt="Logo Google Ads" class="ds-tool-logo img img-fluid o_we_custom_image js_ds_tool_logo_source" data-tool-key="google-ads"/></span><span class="ds-tool-label">Google Ads</span></span><span class="ds-tool"><span class="ds-tool-logo-slot"><img src="/website_dsolution/static/src/img/brands/google-analytics.svg" alt="Logo Google Analytics" class="ds-tool-logo img img-fluid o_we_custom_image js_ds_tool_logo_source" data-tool-key="google-analytics"/></span><span class="ds-tool-label">Google Analytics</span></span><span class="ds-tool"><span class="ds-tool-logo-slot"><img src="/website_dsolution/static/src/img/brands/google-tag-manager.svg" alt="Logo Google Tag Manager" class="ds-tool-logo img img-fluid o_we_custom_image js_ds_tool_logo_source" data-tool-key="google-tag-manager"/></span><span class="ds-tool-label">Google Tag Manager</span></span><span class="ds-tool"><span class="ds-tool-logo-slot"><img src="/website_dsolution/static/src/img/brands/photoshop.svg" alt="Logo Photoshop" class="ds-tool-logo img img-fluid o_we_custom_image js_ds_tool_logo_source" data-tool-key="photoshop"/></span><span class="ds-tool-label">Photoshop</span></span><span class="ds-tool"><span class="ds-tool-logo-slot"><img src="/website_dsolution/static/src/img/brands/codex.svg" alt="Logo Codex" class="ds-tool-logo img img-fluid o_we_custom_image js_ds_tool_logo_source" data-tool-key="codex"/></span><span class="ds-tool-label">Codex</span></span><span class="ds-tool"><span class="ds-tool-logo-slot"><img src="/website_dsolution/static/src/img/brands/claude.svg" alt="Logo Claude Code" class="ds-tool-logo img img-fluid o_we_custom_image js_ds_tool_logo_source" data-tool-key="claude"/></span><span class="ds-tool-label">Claude Code</span></span><span class="ds-tool"><span class="ds-tool-logo-slot"><img src="/website_dsolution/static/src/img/brands/n8n.svg" alt="Logo n8n" class="ds-tool-logo img img-fluid o_we_custom_image js_ds_tool_logo_source" data-tool-key="n8n"/></span><span class="ds-tool-label">n8n</span></span>
                        </div>
                    </div>
                    <div class="ds-marquee ds-marquee--reverse">
                        <div class="ds-marquee-track">
                            <span class="ds-tool"><span class="ds-tool-logo-slot"><img src="/website_dsolution/static/src/img/brands/wordpress.svg" alt="Logo WordPress" class="ds-tool-logo img img-fluid o_we_custom_image js_ds_tool_logo_source" data-tool-key="wordpress"/></span><span class="ds-tool-label">WordPress</span></span><span class="ds-tool"><span class="ds-tool-logo-slot"><img src="/website_dsolution/static/src/img/brands/nextjs.svg" alt="Logo Next.js" class="ds-tool-logo img img-fluid o_we_custom_image js_ds_tool_logo_source" data-tool-key="nextjs"/></span><span class="ds-tool-label">Next.js</span></span><span class="ds-tool"><span class="ds-tool-logo-slot"><img src="/website_dsolution/static/src/img/brands/wix.svg" alt="Logo Wix" class="ds-tool-logo img img-fluid o_we_custom_image js_ds_tool_logo_source" data-tool-key="wix"/></span><span class="ds-tool-label">Wix</span></span><span class="ds-tool"><span class="ds-tool-logo-slot"><img src="/website_dsolution/static/src/img/brands/vmix.png" alt="Logo vMix" class="ds-tool-logo img img-fluid o_we_custom_image js_ds_tool_logo_source" data-tool-key="vmix"/></span><span class="ds-tool-label">vMix</span></span><span class="ds-tool"><span class="ds-tool-logo-slot"><img src="/website_dsolution/static/src/img/brands/blackmagic.svg" alt="Logo Blackmagic Design" class="ds-tool-logo img img-fluid o_we_custom_image js_ds_tool_logo_source" data-tool-key="blackmagic"/></span><span class="ds-tool-label">Blackmagic Design</span></span><span class="ds-tool"><span class="ds-tool-logo-slot"><img src="/website_dsolution/static/src/img/brands/obs.svg" alt="Logo OBS Studio" class="ds-tool-logo img img-fluid o_we_custom_image js_ds_tool_logo_source" data-tool-key="obs"/></span><span class="ds-tool-label">OBS Studio</span></span><span class="ds-tool"><span class="ds-tool-logo-slot"><img src="/website_dsolution/static/src/img/brands/tiktok.svg" alt="Logo TikTok Ads" class="ds-tool-logo img img-fluid o_we_custom_image js_ds_tool_logo_source" data-tool-key="tiktok"/></span><span class="ds-tool-label">TikTok Ads</span></span><span class="ds-tool"><span class="ds-tool-logo-slot"><img src="/website_dsolution/static/src/img/brands/odoo.svg" alt="Logo Odoo" class="ds-tool-logo img img-fluid o_we_custom_image js_ds_tool_logo_source" data-tool-key="odoo"/></span><span class="ds-tool-label">Odoo</span></span>
                        </div>
                    </div>
                </section>

<section id="portafolio" class="ds-section ds-section--white">
                    <div class="ds-container">
                        <div class="ds-reveal">
                            <p class="ds-eyebrow">Portafolio</p>
                            <h2 class="ds-title">Proyectos que inspiran nuevas ideas</h2>
                            <p class="ds-subtitle">Una selección inicial de trabajos que combinan estrategia, creatividad y tecnología. Esta sección se conectará después con datos de Odoo.</p>
                            <span class="ds-divider"/>
                        </div>
                        <div class="ds-portfolio-grid">
                            <article class="ds-project ds-reveal"><div class="ds-project-media"><img src="/website_dsolution/static/src/img/content/service-audiovisual.jpg" alt="Producción audiovisual" class="img img-fluid o_we_custom_image" loading="lazy" decoding="async"/></div><div class="ds-project-body"><p class="ds-project-category">Audiovisual</p><h3>Producción audiovisual</h3><p>Contenido visual y soporte técnico para comunicar con más impacto.</p><a href="#contacto">Ver proyecto →</a></div></article>
                            <article class="ds-project ds-reveal"><div class="ds-project-media"><img src="/website_dsolution/static/src/img/content/service-marketing.jpg" alt="Campaña digital" class="img img-fluid o_we_custom_image" loading="lazy" decoding="async"/></div><div class="ds-project-body"><p class="ds-project-category">Marketing</p><h3>Campaña digital</h3><p>Estrategia, medición y optimización para generar oportunidades reales.</p><a href="#contacto">Ver proyecto →</a></div></article>
                            <article class="ds-project ds-reveal"><div class="ds-project-media"><img src="/website_dsolution/static/src/img/content/service-web.jpg" alt="Sitio web corporativo" class="img img-fluid o_we_custom_image" loading="lazy" decoding="async"/></div><div class="ds-project-body"><p class="ds-project-category">Web</p><h3>Sitio web corporativo</h3><p>Diseño y estructura para una presencia digital clara, rápida y premium.</p><a href="#contacto">Ver proyecto →</a></div></article>
                        </div>
                    </div>
                </section>

                <t t-call="website_dsolution.contact"/>
                <t t-call="website_dsolution.footer"/>
            </div>
        </xpath>
    </template>
</odoo>
